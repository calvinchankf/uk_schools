# Copy to .env.local for local overrides (gitignored). Both are optional —
# unset means "static mode", which is the safe default (see src/services/api.js).

# "static" (default) reads bundled JSON in public/data/, no backend needed.
# "api" calls the FastAPI backend at VITE_API_BASE_URL.
VITE_DATA_MODE=static

# Only used when VITE_DATA_MODE=api.
VITE_API_BASE_URL=http://localhost:8000
